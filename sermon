#!/usr/bin/env python3
"""
Run with:  python3 sermon audio <file>     (first time: python3 sermon setup)

If `python3 sermon setup` has been run, this automatically switches to the
project's private .venv, so optional packages (speech-to-text, a bundled ffmpeg)
never touch your system Python.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
VENV = os.path.join(ROOT, ".venv")


def _venv_python():
    parts = ("Scripts", "python.exe") if os.name == "nt" else ("bin", "python")
    path = os.path.join(VENV, *parts)
    return path if os.path.exists(path) else None


def _in_venv():
    return os.path.realpath(sys.prefix) == os.path.realpath(VENV)


def main():
    python = _venv_python()
    if python and not _in_venv() and not os.environ.get("SERMON_NO_VENV"):
        # Re-run this same command under the project's own Python.
        command = [python, os.path.abspath(__file__)] + sys.argv[1:]
        if os.name == "nt":
            sys.exit(subprocess.call(command))
        os.execv(python, command)

    # Make `app` importable from anywhere. Paths you type (the audio file) resolve
    # from your current folder; config, cache and output always use this project.
    sys.path.insert(0, ROOT)
    from app.cli import main as cli_main

    sys.exit(cli_main())


if __name__ == "__main__":
    main()
