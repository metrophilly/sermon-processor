{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metrophilly/sermon-processor/config/transcript_schema.json",
  "title": "Sermon Transcript (raw layer), schema version 1",
  "description": "One machine transcript of one audio file. All times are milliseconds from the start of that file. Never edited after export: corrections live in a separate layer that refers to word IDs.",
  "type": "object",
  "required": ["schema_version", "layer", "sermon_id", "date", "audio", "model", "word_count", "paragraphs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "layer": { "const": "raw" },
    "sermon_id": { "type": "string", "minLength": 1, "description": "Published Sanity _id (no drafts. prefix) or a local label when not from Sanity" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "audio": {
      "type": "object",
      "required": ["file", "sha256", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "duration_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "required": ["engine", "name", "settings"],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "settings": { "type": "object" }
      }
    },
    "word_count": { "type": "integer", "minimum": 0 },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "index", "start_ms", "end_ms", "text", "word_count", "avg_confidence", "min_confidence", "words"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p\\d{3,}$" },
          "index": { "type": "integer", "minimum": 1 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" },
          "word_count": { "type": "integer", "minimum": 1 },
          "avg_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "start_ms", "end_ms", "text", "confidence"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^w\\d{6,}$" },
                "start_ms": { "type": "integer", "minimum": 0 },
                "end_ms": { "type": "integer", "minimum": 0 },
                "text": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
